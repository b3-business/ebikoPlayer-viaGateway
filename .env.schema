# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=true @defaultSensitive=false
# @currentEnv=$DEV_ENV
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Selects the committed Varlock profile file (for example .env.jb).
# @type=enum(jb, test, production)
DEV_ENV=jb

# HTTP port for the small status server.
# @type=number
PORT=3000

# Discord guild/server IDs. Keep as strings because Discord snowflakes exceed JS safe integers.
BGF_GUILD_ID=
BRUDI_GUILD_ID=

# Discord application/client ID.
CLIENT_ID=

# Discord bot token.
# @sensitive
DISCORD_TOKEN=

# S3-compatible MinIO access credentials and bucket.
# @sensitive
MINIO_S3_ACCESS_KEY=
# @sensitive
MINIO_S3_SECRET_KEY=
MINIO_S3_BUCKET_NAME=
