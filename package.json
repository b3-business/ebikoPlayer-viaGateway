{
  "name": "ebikoplayer",
  "version": "0.0.1",
  "description": "Discord Bot to stream audio from local source or input stream to voice chat. ",
  "main": "index.js",
  "scripts": {
    "deploy-commands": "DEV_ENV=jb varlock run -- bun run ./deploy-commands.ts",
    "prestart": "bun run deploy-commands",
    "start": "DEV_ENV=jb varlock run -- tsx ./index.ts",
    "predev": "bun run deploy-commands",
    "dev": "DEV_ENV=jb varlock run -- tsx ./index.ts",
    "prod": "DEV_ENV=jb varlock run -- tsx ./index.ts"
  },
  "author": "Bastian Ebiko Jesuiter",
  "license": "ISC",
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.17.0",
    "@types/express": "^4.17.21",
    "baojs": "^0.2.1",
    "discord.js": "^14.16.1",
    "express": "^4.19.2",
    "fuse.js": "^7.0.0",
    "libsodium-wrappers": "^0.7.15",
    "minio": "^8.0.1",
    "node-microphone": "^0.1.6",
    "tsx": "^4.19.0",
    "varlock": "^1.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
